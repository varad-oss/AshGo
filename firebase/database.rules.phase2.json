          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.token.email_verified === true && !data.exists() && newData.child('memberA').val() === auth.uid && !newData.child('memberB').exists() && !newData.child('confirmedAt').exists()",
          ".validate": "newData.hasChildren(['memberA', 'relationship', 'createdAt'])",
          "memberA": {
