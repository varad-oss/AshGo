          },
          "confirmedAt": {
            ".write": "auth != null && !data.exists() && root.child('pairs').child($pairId).child('meta/memberA').val() === auth.uid && root.child('pairs').child($pairId).child('meta/memberB').exists()",
            ".validate": "newData.val() === now"
          },
          "$other": {
            ".validate": false
          },
          ".read": "auth != null && (root.child('pairs').child($pairId).child('meta').child('memberA').val() === auth.uid || root.child('pairs').child($pairId).child('meta').child('memberB').val() === auth.uid)"
