        ".validate": "newData.isString()"
      }
    },
    "invites": {
      "$emailKey": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.token.email_verified === true && auth.token.email.toLowerCase().replace('.', ',') === $emailKey",
        "$pairId": {
          ".read": "auth != null && data.child('fromUid').val() === auth.uid",
          ".write": "auth != null && auth.token.firebase.sign_in_provider === 'google.com' && auth.token.email_verified === true && ((newData.exists() && newData.child('fromUid').val() === auth.uid && root.child('pairs').child($pairId).child('meta').child('memberA').val() === auth.uid && !root.child('pairs').child($pairId).child('meta').child('memberB').exists()) || (!newData.exists() && (data.child('fromUid').val() === auth.uid || auth.token.email.toLowerCase().replace('.', ',') === $emailKey)))",
          ".validate": "newData.hasChildren(['fromUid', 'fromName', 'fromEmail', 'createdAt', 'expiresAt'])",
          "fromUid": {
            ".validate": "newData.isString()"
          },
          "fromName": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 40"
          },
          "fromEmail": {
            ".validate": "newData.val() === auth.token.email"
          },
          "createdAt": {
            ".validate": "newData.val() === now"
          },
          "expiresAt": {
            ".validate": "newData.isNumber() && newData.val() > now && newData.val() <= now + 86400000"
          },
          "$other": {
            ".validate": false
          }
        }
      }
    },
    "pairs": {
      "$pairId": {
        ".write": "auth != null && !newData.exists() && (data.child('meta/memberA').val() === auth.uid || data.child('meta/memberB').val() === auth.uid)",
