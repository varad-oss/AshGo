    <string name="help_status_title">What the status means</string>
    <string name="help_status_body">Live: their phone reported in the last couple of minutes. Recent: within the last 15 minutes. Stale or offline: AshGo hasn\'t heard from their phone, so it shows when it last did. Paused: they chose to pause sharing.</string>
    <string name="help_reliability_title">Keeping AshGo reliable</string>
    <string name="help_reliability_body">Open Settings → Reliability and fix anything marked. Allow notifications, keep SOS alerts on, and let AshGo run without battery restrictions.</string>
    <string name="help_sos_title">How SOS works</string>
    <string name="help_sos_body">Hold the SOS button for 3 seconds. Your partner gets an alert at once, and your emergency contacts get a text with your location. AshGo shows each step as it happens, and never says delivered unless the network confirms it.</string>
    <string name="help_sms_title">SMS costs</string>
    <string name="help_sms_body">SOS texts are ordinary SMS from your SIM, one or two per contact. Your plan\'s usual charges apply.</string>
