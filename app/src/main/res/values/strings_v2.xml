    <string name="privacy_where_title">Where your data lives</string>
    <string name="privacy_where_body">Only in your shared orbit, readable by the two of you. No ads, no analytics, no third parties. Leaving the orbit deletes all of it.</string>
    <string name="privacy_kept_title">How long it is kept</string>
    <string name="privacy_kept_body">Messages 7 days · photos 3 days · check-ins 7 days · trips 24 hours after they end · cancelled SOS 30 days. Your location is only your latest point, and it is removed when you stop sharing.</string>
    <string name="privacy_phone_title">Only on this phone</string>
    <string name="privacy_phone_body">Emergency contacts and fake call voices never leave this phone. Our page photos are shared only with your orbit.</string>
    <string name="privacy_delete_messages">Delete my messages now</string>
    <string name="privacy_delete_messages_body">Removes every message and photo you sent in this orbit, for both of you. Their messages stay.</string>
