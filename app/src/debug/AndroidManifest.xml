<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only. Exported so `adb shell am start` can open it on a non-root emulator. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- v2 background connection + notifications (debug only until the Stage 11 cutover). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Debug only: lets instrumented tests reach the local Firebase emulators over plain HTTP at 10.0.2.2. -->
    <application android:networkSecurityConfig="@xml/network_security_config_debug">
        <!-- v2 dev entry point (debug only until the Stage 11 cutover). -->
        <activity
            android:name="com.varad.unstoppableash.V2Activity"
            android:exported="true"
            android:label="AshGo v2 (dev)"
            android:theme="@style/Theme.AshGo"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- v2 SOS hold screen + Quick Settings tile (debug only until the Stage 11 cutover). -->
        <activity
            android:name="com.varad.unstoppableash.feature.safety.SosHoldActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:label="@string/sos_tile_label"
            android:launchMode="singleTask"
            android:taskAffinity="com.varad.unstoppableash.sos"
            android:theme="@style/Theme.AshGo" />
        <service
            android:name="com.varad.unstoppableash.feature.safety.SosTileService"
            android:exported="true"
            android:icon="@drawable/ic_orbit_glyph"
            android:label="@string/sos_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <!-- v2 location sharing (debug only until the Stage 11 cutover). -->
        <service
            android:name="com.varad.unstoppableash.service.location.LocationShareService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <service
            android:name="com.varad.unstoppableash.service.connect.StayConnectedService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a live connection so a partner's safety alerts (SOS, overdue trip) arrive without a push server." />
        </service>
        <receiver
            android:name="com.varad.unstoppableash.service.connect.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.varad.unstoppableash.service.notify.TripActionReceiver"
            android:exported="false" />
        <activity
            android:name="com.varad.unstoppableash.feature.safety.PartnerSosActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.varad.unstoppableash.partnersos"
            android:theme="@style/Theme.AshGo" />
        <activity
            android:name=".catalog.DesignCatalogActivity"
            android:exported="true"
            android:label="@string/catalog_title"
            android:theme="@style/Theme.AshGo" />
    </application>
</manifest>
